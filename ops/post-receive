#!/usr/bin/env bash
# Bare-repo hook: checks the pushed branch out into the working tree and
# deploys it. `git push production main` is the whole pipeline - no platform, no
# webhook, no CI account.
set -euo pipefail

# A hook runs with GIT_DIR pointing at the bare repo and a minimal PATH. Left
# alone, the first git command in the worktree would target the bare repo and
# docker would not be found at all.
unset GIT_DIR GIT_WORK_TREE
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

BARE=/srv/pasen.git
WORKTREE=/srv/pasen
BRANCH=main

while read -r _old _new ref; do
	if [ "$ref" != "refs/heads/$BRANCH" ]; then
		echo "ignoring $ref; only $BRANCH deploys"
		continue
	fi

	echo "==> checking out $BRANCH"
	git --git-dir="$BARE" --work-tree="$WORKTREE" checkout -f "$BRANCH"

	cd "$WORKTREE"
	./deploy.sh
done
