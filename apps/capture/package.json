{
  "name": "pasen-capture",
  "productName": "Pasen Capture",
  "version": "0.2.0",
  "private": true,
  "description": "Captures League custom games and sends them to Pasen",
  "author": "Aksel",
  "license": "UNLICENSED",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.cjs\"",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "tech.aspenne.pasen.capture",
    "productName": "Pasen Capture",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/tray*.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Pasen-Capture-Setup-${version}.${ext}"
    },
    "dmg": {
      "artifactName": "Pasen-Capture-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  }
}
