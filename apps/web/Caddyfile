# Serves the built SPA. The public site is read-only, so everything here is
# cacheable except the entry point.
:80 {
	root * /srv
	encode zstd gzip

	# Hashed asset filenames, so they can be cached hard and forever.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Everything else resolves to index.html, whatever the request path: matching
	# on "/index.html" alone would miss "/" and every client-side route, and a
	# cached entry point means a deploy never reaches anyone.
	@entrypoint not path /assets/*
	header @entrypoint Cache-Control "no-cache"

	# Client-side routing: unknown paths are routes, not missing files.
	try_files {path} /index.html
	file_server
}
