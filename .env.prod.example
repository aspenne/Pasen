# Copy to .env on the server. Every value marked :? below is required - compose
# refuses to start without it rather than falling back to a development default.

# The domain Caddy will get a certificate for.
PUBLIC_DOMAIN=pasen.example.com
# Same host, with the scheme. Used for CORS and baked into the frontend build.
PUBLIC_URL=https://pasen.example.com

DEFAULT_GROUP=arigafion

# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
APP_KEY=

DB_USER=pasen
DB_PASSWORD=
DB_DATABASE=pasen

LOG_LEVEL=info

# Optional bootstrap only. The key lives in the database and is rotated at /admin.
RIOT_API_KEY=

RIOT_RATE_PER_SECOND=18
RIOT_RATE_PER_TWO_MINUTES=95
RIOT_FETCH_TIMELINES=false
