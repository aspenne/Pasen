# Copy to .env and adjust. Consumed by docker compose, which injects these into
# the api and worker containers (container env wins over apps/api/.env).

# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
APP_KEY=replace-me

LOG_LEVEL=info

DB_USER=pasen
DB_PASSWORD=pasen
DB_DATABASE=pasen

# Ports the containers publish on the host. Postgres defaults to 5433 because a
# locally installed Postgres binds 127.0.0.1:5432 specifically, which wins over
# Docker's wildcard bind and silently hijacks every connection from the host.
DB_HOST_PORT=5433
REDIS_HOST_PORT=6379

WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3333

# Riot development keys expire every 24h. Leave blank and paste the key in /admin
# instead: the database is the source of truth, this is only the bootstrap value.
RIOT_API_KEY=

# Safety margin under the published 20/s and 100/2min limits.
RIOT_RATE_PER_SECOND=18
RIOT_RATE_PER_TWO_MINUTES=95

# Timelines double the API cost per match. Off until the backfill is settled.
RIOT_FETCH_TIMELINES=false
