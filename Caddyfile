# One origin for the site and its API, so the admin session cookie is
# first-party and no CORS preflight stands between the two.
#
# SITE_HOSTS lists every domain the site answers on ("aspenne.tech,
# aspenne.fun"); compose defaults it to PUBLIC_DOMAIN alone. Each domain is a
# full copy rather than a redirect, so links shared with either keep working
# and the capture app's uploads - a POST, which a redirect would drop - still
# land.
{$SITE_HOSTS} {
	encode zstd gzip

	# Everything the browser calls, health check included, lives under /api, so
	# there is a single prefix to route.
	handle /api/* {
		reverse_proxy api:3333
	}

	handle {
		reverse_proxy web:80
	}
}

# Each www redirects to its own bare domain: www.aspenne.fun to aspenne.fun.
{$WWW_HOSTS} {
	redir https://{http.request.host.labels.1}.{http.request.host.labels.0}{uri} permanent
}
